{
  "name": "rupsa-next",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --prefix web",
    "dev:api": "npm run dev --prefix api",
    "dev:all": "sh -c 'npm run dev:api & npm run dev:web; wait'",
    "dev:mobile": "npm run start --prefix mobile",
    "build": "npm run build --prefix web && npm run build --prefix api",
    "lint": "npm run lint --prefix web",
    "db:migrate": "npm run prisma:migrate --prefix api",
    "db:seed": "npm run db:seed --prefix api"
  }
}
