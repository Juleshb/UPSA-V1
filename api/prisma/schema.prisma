// ---------------------------------------------------------------------------
// Lending — products and the lifecycle around the existing loan register
// ---------------------------------------------------------------------------

model LoanProduct {
  id                 String   @id @default(cuid())
  publicId           String   @unique
  code               String   @unique
  name               String
  description        String?
  customerType       String
  purpose            String
  currency           String   @default("RWF")
  status             String   @default("ACTIVE")
  interestRate       Decimal  @db.Decimal(8, 3)
  interestMethod     String   @default("DECLINING")
  processingFeeRate  Decimal  @default(0) @db.Decimal(8, 3)
  insuranceFeeRate   Decimal  @default(0) @db.Decimal(8, 3)
  guaranteeFeeRate   Decimal  @default(0) @db.Decimal(8, 3)
  lateFeeRate        Decimal  @default(0) @db.Decimal(8, 3)
  otherCharges       Decimal  @default(0) @db.Decimal(18, 2)
  minimumAmount      Decimal  @db.Decimal(18, 2)
  maximumAmount      Decimal  @db.Decimal(18, 2)
  minimumTenor       Int
  maximumTenor       Int
  graceMonths        Int      @default(0)
  repaymentFrequency String   @default("MONTHLY")
  eligibility        String?
  maximumExposure    Decimal? @db.Decimal(18, 2)
  debtServiceRule    String?
  guaranteeRequired  Boolean  @default(false)
  collateralRequired Boolean  @default(false)
  allocationOrder    String   @default("FEES,INTEREST,PENALTY,PRINCIPAL")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model LendingCase {
  id                    String          @id @default(cuid())
  publicId              String          @unique
  applicationId         String          @unique
  customerType          String
  applicantName         String
  representative        String?
  memberPublicId        String?
  monthlyRevenue        Decimal         @default(0) @db.Decimal(18, 2)
  monthlyExpenses       Decimal         @default(0) @db.Decimal(18, 2)
  existingDebt          Decimal         @default(0) @db.Decimal(18, 2)
  existingRepayments    Decimal         @default(0) @db.Decimal(18, 2)
  applicantContribution Decimal         @default(0) @db.Decimal(18, 2)
  expectedCashFlow      String?
  graceMonths           Int             @default(0)
  repaymentFrequency    String          @default("MONTHLY")
  collateralAvailable   Boolean         @default(false)
  collateralType        String?
  collateralValue       Decimal?        @db.Decimal(18, 2)
  collateralOwner       String?
  details               Json?
  application           LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model LendingDocument {
  id             String          @id @default(cuid())
  publicId       String          @unique
  applicationId  String
  documentType   String
  documentNumber String?
  issueDate      DateTime?
  expiryDate     DateTime?
  fileName       String
  status         String          @default("PENDING")
  comment        String?
  verifiedBy     String?
  verifiedAt     DateTime?
  createdAt      DateTime        @default(now())
  application    LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model LendingKyc {
  id                 String          @id @default(cuid())
  publicId           String          @unique
  applicationId      String
  kind               String
  fullName           String?
  idType             String?
  idNumber           String?
  dateOfBirth        DateTime?
  address            String?
  phone              String?
  email              String?
  organizationName   String?
  registrationNumber String?
  taxId              String?
  directors          String?
  owners             String?
  representative     String?
  beneficialOwners   String?
  result             String
  officerName        String
  reviewedAt         DateTime        @default(now())
  application        LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model LendingConsent {
  id            String          @id @default(cuid())
  publicId      String          @unique
  applicationId String
  purpose       String
  scope         String
  institution   String
  effectiveDate DateTime
  expiryDate    DateTime
  version       String
  status        String          @default("ACTIVE")
  createdAt     DateTime        @default(now())
  application   LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model LendingAssessment {
  id                 String          @id @default(cuid())
  publicId           String          @unique
  applicationId      String
  revenue            Decimal         @db.Decimal(18, 2)
  collections        Decimal         @db.Decimal(18, 2)
  collectionRate     Decimal         @db.Decimal(8, 3)
  expenses           Decimal         @db.Decimal(18, 2)
  exposure           Decimal         @db.Decimal(18, 2)
  debtService        Decimal         @db.Decimal(18, 2)
  freeCashFlow       Decimal         @db.Decimal(18, 2)
  repaymentCapacity  String
  cashFlowStability  String
  paymentHistory     String
  trend              String
  risks              String?
  mitigation         String?
  result             String
  officerName        String
  createdAt          DateTime        @default(now())
  application        LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model LoanOffer {
  id            String          @id @default(cuid())
  publicId      String          @unique
  applicationId String
  amount        Decimal         @db.Decimal(18, 2)
  interestRate  Decimal         @db.Decimal(8, 3)
  tenorMonths   Int
  graceMonths   Int             @default(0)
  frequency     String
  fees          Decimal         @default(0) @db.Decimal(18, 2)
  conditions    String?
  expiresOn     DateTime
  response      String          @default("PENDING")
  acceptedBy    String?
  acceptedAt    DateTime?
  createdAt     DateTime        @default(now())
  application   LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model LoanContract {
  id                 String          @id @default(cuid())
  publicId           String          @unique
  contractNumber     String          @unique
  applicationId      String
  loanId             String?
  principal          Decimal         @db.Decimal(18, 2)
  interest           Decimal         @db.Decimal(18, 2)
  fees               Decimal         @db.Decimal(18, 2)
  tenorMonths        Int
  security           String?
  guarantee          String?
  defaultTerms       String?
  otherTerms         String?
  borrowerSigned     Boolean         @default(false)
  institutionSigned  Boolean         @default(false)
  representative     String?
  signedAt           DateTime?
  createdAt          DateTime        @default(now())
  application        LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model LendingCollateral {
  id                 String          @id @default(cuid())
  publicId           String          @unique
  applicationId      String
  collateralType     String
