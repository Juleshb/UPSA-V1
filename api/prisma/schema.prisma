  officerName  String
  createdAt    DateTime  @default(now())
  member       Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model MembershipReactivation {
  id              String   @id @default(cuid())
  publicId        String   @unique
  memberId        String
  previousStatus  String
  reason          String
