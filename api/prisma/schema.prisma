  penalty       Decimal  @default(0) @db.Decimal(18, 2)
  totalPayable  Decimal  @db.Decimal(18, 2)
  currency      String   @default("RWF")
  dueDate       DateTime?
  status        String   @default("DUE")
  createdAt     DateTime @default(now())
  member        Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  payments      MembershipFeePayment[]

  @@index([memberId])
  @@index([status])
}

model MembershipFeePayment {
