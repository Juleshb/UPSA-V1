  status      String    @default("PENDING")
  loan        Loan      @relation(fields: [loanId], references: [id], onDelete: Cascade)
}

model LendingRecovery {
  id             String    @id @default(cuid())
  publicId       String    @unique
  loanId         String
  outstanding    Decimal   @db.Decimal(18, 2)
  daysPastDue    Int
  stage          String
  officer        String
  strategy       String
  nextAction     String
  nextActionDate DateTime?
  loan           Loan      @relation(fields: [loanId], references: [id], onDelete: Cascade)
}

model LendingWriteOff {
  id          String   @id @default(cuid())
  publicId    String   @unique
  loanId      String
  principal   Decimal  @db.Decimal(18, 2)
  interest    Decimal  @db.Decimal(18, 2)
  fees        Decimal  @db.Decimal(18, 2)
  total       Decimal  @db.Decimal(18, 2)
  history     String?
  reason      String
  evidence    String?
  requestedBy String
  approvedBy  String?
  status      String   @default("REQUESTED")
  loan        Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
}

model LendingRestructure {
  id            String    @id @default(cuid())
  publicId      String    @unique
