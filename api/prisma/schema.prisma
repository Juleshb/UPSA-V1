generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

enum UserRole {
  PARENT
  SCHOOL_USER
  RUPSA_USER
  BANK_USER
  MFI_USER
  PSP_USER
  AUDITOR
  SYSTEM_ADMINISTRATOR
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

model User {
  id           String     @id @default(cuid())
  publicId     String     @unique
  email        String     @unique
  passwordHash String
  fullName     String
  phone        String?
  role         UserRole
  status       UserStatus @default(ACTIVE)
  mfaEnabled   Boolean    @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  schoolLinks       SchoolUser[]
  institutionLinks  InstitutionUser[]
  refreshTokens     RefreshToken[]
  guardian          Guardian?
  auditLogs         AuditLog[]
  accessLogs        AccessLog[]
  notifications     Notification[]
  openedAccounts    OpenedAccount[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Education — schools
// ---------------------------------------------------------------------------

enum SchoolStatus {
  APPLICATION
  SUBMITTED
  DOCUMENT_REVIEW
  PENDING_VERIFICATION
  VERIFICATION
  APPROVED
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum SchoolType {
  NURSERY
  PRIMARY
  SECONDARY
  TVET
  SPECIAL_EDUCATION
  COMBINED
  OTHER
}

enum OwnershipType {
  PRIVATE
  PUBLIC
  GOVERNMENT_AIDED
  FAITH_BASED
  COMMUNITY
  OTHER
}

enum OperatingStatus {
  OPERATING
  TEMPORARILY_CLOSED
  CLOSED
}

enum LegalStatus {
  REGISTERED
  PROVISIONALLY_REGISTERED
  LICENSED
  SUSPENDED
  OTHER
}

enum RegistrationReviewStatus {
  PENDING
  VERIFIED
  MORE_INFORMATION_REQUIRED
  REJECTED
}

enum KybStatus {
  PENDING
  IN_REVIEW
  VERIFIED
  REJECTED
}

enum MembershipStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

model School {
  id                      String       @id @default(cuid())
  publicId                String       @unique
  rupsaMemberId           String?      @unique
  schoolName              String
  registrationNumber      String       @unique
  schoolType              SchoolType?
  ownershipType           OwnershipType?
  dateEstablished         DateTime?
  operatingStatus         OperatingStatus?
  studentCount            Int?
  teacherCount            Int?
  staffCount              Int?
  taxIdentificationNumber String?
  registrationCertificateNumber String?
  registrationDate        DateTime?
  registrationAuthority   String?
  licenseNumber           String?
  licenseExpiryDate       DateTime?
  legalStatus             LegalStatus?
  phone                   String
  alternativePhone        String?
  email                   String
  website                 String?
  emergencyContact        String?
  province                String
  district                String
  sector                  String?
  cell                    String?
  village                 String?
  physicalAddress         String?
  gpsCoordinates          String?
  postalAddress           String?
  status                  SchoolStatus     @default(APPLICATION)
  kybStatus               KybStatus        @default(PENDING)
  membershipStatus        MembershipStatus @default(UNVERIFIED)
  reviewStatus            RegistrationReviewStatus @default(PENDING)
  registrationVerified    Boolean          @default(false)
  legalDocumentsVerified  Boolean          @default(false)
  representativeVerified  Boolean          @default(false)
  addressVerified         Boolean          @default(false)
  bankAccountVerified     Boolean          @default(false)
  documentsComplete       Boolean          @default(false)
  membershipApplicationId String?          @unique
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  membershipApplication   MembershipApplication? @relation(fields: [membershipApplicationId], references: [id])

  users              SchoolUser[]
  representatives    SchoolRepresentative[]
  ownerships         SchoolOwnership[]
  bankAccounts       SchoolBankAccount[]
  documents          SchoolDocument[]
  students           Student[]
  feeStructures      FeeStructure[]
  invoices           Invoice[]
  loanApplications   LoanApplication[]
  guarantees         Guarantee[]
  financialProfiles  FinancialProfile[]
  kycRecords         KycRecord[]
  registrations      Registration[]
  investmentApplications InvestmentApplication[]
  investmentPositions    InvestmentPosition[]
  openedAccounts         OpenedAccount[]
  literacyLearners       LiteracyLearner[]
  escrowGroups           EscrowGroup[]
  escrowMemberships      EscrowGroupMember[]
  escrowAccounts         EscrowAccount[]
  collateralAssets       CollateralAsset[]
  securityApplications   SecurityApplication[]
  securityGuarantees     SecurityGuarantee[]
  memberFile             Member?

  @@index([status])
}

model SchoolUser {
  id       String  @id @default(cuid())
  schoolId String
  userId   String
  title    String?
  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([schoolId, userId])
}

model SchoolRepresentative {
  id              String    @id @default(cuid())
  publicId        String?   @unique
  schoolId        String
  fullName        String
  title           String
  nationalId      String?
  phone           String?
  email           String?
  appointmentDate DateTime?
  authorized      Boolean   @default(true)
  school          School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model SchoolOwnership {
  id           String  @id @default(cuid())
  schoolId     String
  ownerName    String
  ownershipPct Decimal @db.Decimal(5, 2)
  nationalId   String?
  school       School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model SchoolBankAccount {
  id               String    @id @default(cuid())
  schoolId         String
  bankName         String
  branch           String?
  accountName      String
  accountNumber    String
  currency         String    @default("RWF")
  swiftCode        String?
  isPrimary        Boolean   @default(false)
  accountVerified  Boolean   @default(false)
  verifiedBy       String?
  verificationDate DateTime?
  school           School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model SchoolDocument {
  id           String   @id @default(cuid())
  schoolId     String
  documentType String
  fileRef      String
  storedName   String?
  status       String   @default("SUBMITTED")
  uploadedAt   DateTime @default(now())
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Education — students & guardians
// ---------------------------------------------------------------------------

model Guardian {
  id         String   @id @default(cuid())
  publicId   String   @unique
  userId     String?  @unique
  fullName   String
  phone      String?
  email      String?
  nationalId       String?
  preferredChannel PaymentChannel?
  preferredCountry String         @default("RW")
  notifyChannel    String         @default("IN_APP")
  createdAt        DateTime       @default(now())
  updatedAt  DateTime @updatedAt
  user         User?    @relation(fields: [userId], references: [id])
  students     StudentGuardian[]
  registration Registration?
  openedAccounts OpenedAccount[]
  literacyLearners LiteracyLearner[]
}

enum StudentGender {
  FEMALE
  MALE
}

enum StudentStatus {
  APPLICANT
  ACTIVE
  TRANSFERRED
  GRADUATED
  SUSPENDED
  WITHDRAWN
  INACTIVE
}

enum DocumentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model Student {
  id                String        @id @default(cuid())
  publicId          String        @unique
  schoolId          String
  studentExternalId String
  studentName       String
  firstName         String?
  middleName        String?
  lastName          String?
  dateOfBirth       DateTime?
  gender            StudentGender?
  nationality       String?
  photoStoredName   String?
  previousSchool    String?
  admissionDate     DateTime?
  academicYear      String
  classLevel        String
  stream            String?
  grade             String?
  feeCategory       String?
  province          String?
  district          String?
  sector            String?
  cell              String?
  village           String?
  physicalAddress   String?
  telephone         String?
  emergencyContact  String?
  status            StudentStatus @default(ACTIVE)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  school            School        @relation(fields: [schoolId], references: [id])
  guardians         StudentGuardian[]
  documents         StudentDocument[]
  invoices          Invoice[]
  financialAccount  StudentFinancialAccount?
  openedAccounts    OpenedAccount[]
  literacyLearners  LiteracyLearner[]

  @@unique([schoolId, studentExternalId])
  @@index([schoolId])
}

model StudentGuardian {
  studentId                  String
  guardianId                 String
  relationship               String  @default("Guardian")
  isPrimary                  Boolean @default(false)
  isEmergencyContact         Boolean @default(false)
  financialResponsibility    Boolean @default(false)
  communicationAuthorization Boolean @default(false)
  paymentAuthorization       Boolean @default(false)
  student                    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian                   Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@id([studentId, guardianId])
}

model StudentDocument {
  id                 String                     @id @default(cuid())
  studentId          String
  documentType       String
  documentNumber     String?
  issueDate          DateTime?
  expiryDate         DateTime?
  fileRef            String
  storedName         String?
  verificationStatus DocumentVerificationStatus @default(PENDING)
  uploadedAt         DateTime                   @default(now())
  student            Student                    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model StudentFinancialAccount {
  id                String   @id @default(cuid())
  studentId         String   @unique
  currency          String   @default("RWF")
  feeStructureLabel String?
  scholarship       String?
  discountAmount    Decimal? @db.Decimal(18, 2)
  paymentPlan       String?
  totalBilled       Decimal  @default(0) @db.Decimal(18, 2)
  totalPaid         Decimal  @default(0) @db.Decimal(18, 2)
  outstanding       Decimal  @default(0) @db.Decimal(18, 2)
  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

enum RegistrationKind {
  PARENT
  TEACHER
  SUPPLIER
  INVESTOR
  DONOR
}

enum RegistrationStatus {
  DRAFT
  SUBMITTED
  DOCUMENT_REVIEW
  VERIFICATION
  PENDING_APPROVAL
  APPROVED
  ACTIVE
  MORE_INFORMATION_REQUIRED
  RESUBMITTED
  REJECTED
  SUSPENDED
  INACTIVE
  EXPIRED
  TERMINATED
}

model Registration {
  id                String             @id @default(cuid())
  publicId          String             @unique
  kind              RegistrationKind
  status            RegistrationStatus @default(SUBMITTED)
  displayName       String
  referenceCode     String?
  email             String?
  phone             String?
  alternativePhone  String?
  province          String?
  district          String?
  sector            String?
  cell              String?
  village           String?
  physicalAddress   String?
  postalAddress     String?
  website           String?
  profile           Json
  schoolId          String?
  guardianId        String?            @unique
  identityVerified  Boolean            @default(false)
  documentsVerified Boolean            @default(false)
  contactVerified   Boolean            @default(false)
  addressVerified   Boolean            @default(false)
  financialVerified Boolean            @default(false)
  consentCaptured   Boolean            @default(false)
  duplicateChecked  Boolean            @default(false)
  decision          String?
  approvedBy        String?
  approvalDate      DateTime?
  conditions        String?
  comments          String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  school            School?            @relation(fields: [schoolId], references: [id])
  guardian          Guardian?          @relation(fields: [guardianId], references: [id])
  documents         RegistrationDocument[]
  events            RegistrationEvent[]
  investmentApplications InvestmentApplication[]
  investmentPositions    InvestmentPosition[]
  openedAccounts         OpenedAccount[]
  literacyLearners       LiteracyLearner[]

  @@index([kind, status])
  @@index([email])
}

model RegistrationDocument {
  id                 String                     @id @default(cuid())
  registrationId     String
  documentType       String
  documentNumber     String?
  issueDate          DateTime?
  expiryDate         DateTime?
  issuingAuthority   String?
  fileRef            String
  storedName         String?
  verificationStatus DocumentVerificationStatus @default(PENDING)
  verifiedBy         String?
  verificationDate   DateTime?
  comments           String?
  uploadedAt         DateTime                   @default(now())
  registration       Registration               @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId])
}

model RegistrationEvent {
  id             String              @id @default(cuid())
  registrationId String
  actorId        String?
  action         String
  previousStatus RegistrationStatus?
  newStatus      RegistrationStatus?
  reason         String?
  requestId      String?
  ip             String?
  createdAt      DateTime            @default(now())
  registration   Registration        @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId])
}

model FeeStructure {
  id           String  @id @default(cuid())
  schoolId     String
  academicYear String
  classLevel   String
  feeCategory  String
  description  String
  amount       Decimal @db.Decimal(18, 2)
  currency     String  @default("RWF")
  term         String?
  school       School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, academicYear])
}

// ---------------------------------------------------------------------------
// Financial — invoices / school ledger
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  WRITTEN_OFF
}

model Invoice {
  id          String        @id @default(cuid())
  publicId    String        @unique
  schoolId    String
  studentId   String
  currency    String        @default("RWF")
  amount      Decimal       @db.Decimal(18, 2)
  amountPaid  Decimal       @default(0) @db.Decimal(18, 2)
  balance     Decimal       @db.Decimal(18, 2)
  description String
  dueDate     DateTime
  status      InvoiceStatus @default(ISSUED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  school      School        @relation(fields: [schoolId], references: [id])
  student     Student       @relation(fields: [studentId], references: [id])
  lineItems   InvoiceLineItem[]
  discounts   InvoiceDiscount[]
  adjustments InvoiceAdjustment[]
  payments    Payment[]
  receipts    Receipt[]
  reconciliations Reconciliation[]

  @@index([schoolId, status])
  @@index([studentId])
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  amount      Decimal @db.Decimal(18, 2)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model InvoiceDiscount {
  id          String  @id @default(cuid())
  invoiceId   String
  kind        String
  description String
  amount      Decimal @db.Decimal(18, 2)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model InvoiceAdjustment {
  id          String   @id @default(cuid())
  invoiceId   String
  kind        String
  description String
  amount      Decimal  @db.Decimal(18, 2)
  createdAt   DateTime @default(now())
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Receipt {
  id          String   @id @default(cuid())
  publicId    String   @unique
  invoiceId   String
  paymentId   String?
  amount      Decimal  @db.Decimal(18, 2)
  currency    String   @default("RWF")
  issuedAt    DateTime @default(now())
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  payment     Payment? @relation(fields: [paymentId], references: [id])
}

// ---------------------------------------------------------------------------
// Financial — payments, settlements, reconciliation
// ---------------------------------------------------------------------------

enum PaymentChannel {
  BANK
  PSP
  MOBILE_PAYMENT
  CARD
  OTHER
}

enum RailKind {
  BANK
  PSP
  MOBILE_MONEY
  CARD
}

enum RailStatus {
  APPROVED
  SUSPENDED
}

enum PaymentInfrastructure {
  NATIONAL
  RSWITCH
  TIPS
}

enum CorridorStatus {
  PILOT
  ACTIVE
  PLANNED
}

enum PaymentStatus {
  PENDING
  INITIATED
  SUCCESS
  FAILED
  REVERSED
  REFUNDED
}

model Payment {
  id                   String         @id @default(cuid())
  publicId             String         @unique
  invoiceId            String
  amount               Decimal        @db.Decimal(18, 2)
  currency             String         @default("RWF")
  paymentChannel       PaymentChannel
  payerReference       String?
  status               PaymentStatus  @default(PENDING)
  settlementReference  String?
  transactionReference String?
  idempotencyKey       String?        @unique
  railId               String?
  corridorId           String?
  originCountry        String         @default("RW")
  destinationCountry   String         @default("RW")
  flowCode             String         @default("PAY-01")
  retryCount           Int            @default(0)
  lastError            String?
  instructionRef       String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  invoice              Invoice        @relation(fields: [invoiceId], references: [id])
  rail                 PaymentRail?   @relation(fields: [railId], references: [id])
  corridor             EacCorridor?   @relation(fields: [corridorId], references: [id])
  flowSteps            PaymentFlowStep[]
  receipts             Receipt[]
  reconciliations      Reconciliation[]
  webhookEvents        WebhookEvent[]

  @@index([invoiceId])
  @@index([status])
  @@index([railId])
}

// Approved payment institutions. RUPSA routes instructions; the rail moves funds.
model PaymentRail {
  id              String                @id @default(cuid())
  code            String                @unique
  name            String
  kind            RailKind
  country         String
  infrastructure  PaymentInfrastructure @default(NATIONAL)
  institutionName String
  status          RailStatus            @default(APPROVED)
  priority        Int                   @default(100)
  createdAt       DateTime              @default(now())
  payments        Payment[]

  @@index([country, kind, status])
}

// EAC cross-border extension. Rwanda (RSwitch) ↔ Tanzania (TIPS) is the pilot.
model EacCorridor {
  id                        String                @id @default(cuid())
  code                      String                @unique
  originCountry             String
  destinationCountry        String
  originInfrastructure      PaymentInfrastructure
  destinationInfrastructure PaymentInfrastructure
  originLabel               String
  destinationLabel          String
  status                    CorridorStatus
  payments                  Payment[]

  @@index([status])
}

model PaymentFlowStep {
  id        String   @id @default(cuid())
  paymentId String
  code      String
  label     String
  status    String   @default("RECORDED")
  detail    String?
  createdAt DateTime @default(now())
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
}

enum SettlementStatus {
  PENDING
  COMPLETED
  FAILED
}

model Settlement {
  id            String           @id @default(cuid())
  publicId      String           @unique
  schoolId      String
  amount        Decimal          @db.Decimal(18, 2)
  currency      String           @default("RWF")
  rail          String
  reference     String           @unique
  status        SettlementStatus @default(PENDING)
  settledAt     DateTime?
  createdAt     DateTime         @default(now())
  reconciliations Reconciliation[]
}

enum ReconciliationStatus {
  MATCHED
  PARTIALLY_MATCHED
  UNMATCHED
  DUPLICATE
  FAILED
  PENDING
  REFUNDED
  UNDER_REVIEW
}

model Reconciliation {
  id            String                @id @default(cuid())
  publicId      String                @unique
  invoiceId     String?
  paymentId     String?
  settlementId  String?
  status        ReconciliationStatus  @default(PENDING)
  notes         String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  invoice       Invoice?              @relation(fields: [invoiceId], references: [id])
  payment       Payment?              @relation(fields: [paymentId], references: [id])
  settlement    Settlement?           @relation(fields: [settlementId], references: [id])
}

model WebhookEvent {
  id                   String   @id @default(cuid())
  eventId              String   @unique
  event                String
  paymentId            String?
  invoiceId            String?
  amount               Decimal? @db.Decimal(18, 2)
  currency             String?
  transactionReference String?
  payload              Json
  processedAt          DateTime @default(now())
  payment              Payment? @relation(fields: [paymentId], references: [id])
}

// ---------------------------------------------------------------------------
// Institutions (banks / MFIs / PSPs)
// ---------------------------------------------------------------------------

enum InstitutionType {
  BANK
  MFI
  PSP
}

model FinancialInstitution {
  id          String          @id @default(cuid())
  publicId    String          @unique
  name        String
  type        InstitutionType
  clientId    String          @unique
  webhookUrl  String?
  rateLimit   Int             @default(100)
  status      String          @default("ACTIVE")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  users       InstitutionUser[]
  loanApplications LoanApplication[]
  guarantees  Guarantee[]
  consents    Consent[]
  escrowAccounts EscrowAccount[]
  securityFacilities SecurityFacility[]
  securityGuarantees SecurityGuarantee[]
}

model InstitutionUser {
  id            String               @id @default(cuid())
  institutionId String
  userId        String
  title         String?
  institution   FinancialInstitution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([institutionId, userId])
}

// ---------------------------------------------------------------------------
// Credit — loans
// ---------------------------------------------------------------------------

enum LoanApplicationStatus {
  APPLICATION
  SUBMITTED
  DOCUMENT_CHECK
  KYC_KYB
  ASSESSMENT
  FI_REVIEW
  CREDIT_DECISION
  OFFER
  ACCEPTANCE
  CONTRACT
  DISBURSEMENT
  ACTIVE
  REPAYMENT
  SETTLED
  RECOVERY
  DECLINED
  CANCELLED
}

enum CreditDecision {
  APPROVED
  DECLINED
  CONDITIONAL_APPROVAL
  MORE_INFORMATION_REQUIRED
  CANCELLED
}

model LoanApplication {
  id                       String                 @id @default(cuid())
  publicId                 String                 @unique
  schoolId                 String
  financialInstitutionId   String
  productCode              String
  requestedAmount          Decimal                @db.Decimal(18, 2)
  currency                 String                 @default("RWF")
  tenorMonths              Int
  purpose                  String
  guaranteeRequested       Boolean                @default(false)
  guaranteeAmountRequested Decimal?               @db.Decimal(18, 2)
  status                   LoanApplicationStatus  @default(SUBMITTED)
  decision                 CreditDecision?
  approvedAmount           Decimal?               @db.Decimal(18, 2)
  interestRate             Decimal?               @db.Decimal(6, 3)
  decisionReference        String?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  school                   School                 @relation(fields: [schoolId], references: [id])
  institution              FinancialInstitution   @relation(fields: [financialInstitutionId], references: [id])
  assessments              CreditAssessment[]
  loan                     Loan?
  guarantees               Guarantee[]
  securityApplications     SecurityApplication[]
  securityGuarantees       SecurityGuarantee[]
  securityLinks            SecurityLink[]
  lendingCase              LendingCase?
  lendingDocuments         LendingDocument[]
  lendingKyc               LendingKyc[]
  lendingConsents          LendingConsent[]
  lendingAssessments       LendingAssessment[]
  offers                   LoanOffer[]
  contracts                LoanContract[]
  lendingCollateral        LendingCollateral[]
  lendingGuarantees        LendingGuaranteeRequest[]

  @@index([schoolId])
  @@index([financialInstitutionId])
  @@index([status])
}

enum AssessmentStatus {
  PENDING
  COMPLETED
  FAILED
}

model CreditAssessment {
  id                                 String           @id @default(cuid())
  publicId                           String           @unique
  applicationId                      String
  assessmentStatus                   AssessmentStatus @default(COMPLETED)
  assessmentReference                String           @unique
  financialInstitutionDecisionRequired Boolean        @default(true)
  summary                            Json?
  createdAt                          DateTime         @default(now())
  application                        LoanApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

enum LoanStatus {
  OFFERED
  CONTRACTED
  DISBURSING
  ACTIVE
  IN_ARREARS
  SETTLED
  RECOVERY
  CANCELLED
}

model Loan {
  id                     String   @id @default(cuid())
  publicId               String   @unique
  applicationId          String   @unique
  principal              Decimal  @db.Decimal(18, 2)
  currency               String   @default("RWF")
  tenorMonths            Int
  interestRate           Decimal  @db.Decimal(6, 3)
  principalOutstanding   Decimal  @db.Decimal(18, 2)
  interestOutstanding    Decimal  @default(0) @db.Decimal(18, 2)
  feesOutstanding        Decimal  @default(0) @db.Decimal(18, 2)
