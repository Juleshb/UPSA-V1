  estimatedValue     Decimal         @db.Decimal(18, 2)
  valuationDate      DateTime?
  valuer             String?
  location           String?
  registrationNumber String?
  status             String          @default("PROPOSED")
  application        LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model LendingGuaranteeRequest {
  id                  String          @id @default(cuid())
  publicId            String          @unique
  applicationId       String
  requestedLoan       Decimal         @db.Decimal(18, 2)
  requestedGuarantee  Decimal         @db.Decimal(18, 2)
  percentage          Decimal         @db.Decimal(8, 3)
  facility            String?
  purpose             String
  fee                 Decimal         @default(0) @db.Decimal(18, 2)
  decision            String          @default("PENDING")
  application         LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model LendingPosition {
  id                 String    @id @default(cuid())
  loanId             String    @unique
  penaltyOutstanding Decimal   @default(0) @db.Decimal(18, 2)
  nextDueDate        DateTime?
  daysPastDue        Int       @default(0)
  label              String?
  loan               Loan      @relation(fields: [loanId], references: [id], onDelete: Cascade)
}

model LendingInstallment {
  id             String   @id @default(cuid())
  publicId       String   @unique
  loanId         String
  number         Int
  dueDate        DateTime
  principalDue   Decimal  @db.Decimal(18, 2)
  interestDue    Decimal  @db.Decimal(18, 2)
  feesDue        Decimal  @db.Decimal(18, 2)
  totalDue       Decimal  @db.Decimal(18, 2)
  principalPaid  Decimal  @default(0) @db.Decimal(18, 2)
  interestPaid   Decimal  @default(0) @db.Decimal(18, 2)
  feesPaid       Decimal  @default(0) @db.Decimal(18, 2)
  status         String   @default("DUE")
  loan           Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@unique([loanId, number])
}

model LendingCollection {
  id            String    @id @default(cuid())
  publicId      String    @unique
  loanId        String
  contactDate   DateTime
  method        String
  person        String
  outstanding   Decimal   @db.Decimal(18, 2)
  promiseAmount Decimal?  @db.Decimal(18, 2)
  promiseDate   DateTime?
  followUpDate  DateTime?
  notes         String?
  status        String    @default("OPEN")
  loan          Loan      @relation(fields: [loanId], references: [id], onDelete: Cascade)
}

model LendingPromise {
  id          String    @id @default(cuid())
  publicId    String    @unique
  loanId      String
  outstanding Decimal   @db.Decimal(18, 2)
  promised    Decimal   @db.Decimal(18, 2)
  promiseDate DateTime
  paymentDate DateTime?
  officer     String
