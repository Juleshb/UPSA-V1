  principal     Decimal   @db.Decimal(18, 2)
  interest      Decimal   @db.Decimal(18, 2)
  overdue       Decimal   @db.Decimal(18, 2)
  currentTenor  Int
  newTenor      Int
  frequency     String
  graceMonths   Int       @default(0)
  installment   Decimal   @db.Decimal(18, 2)
  interestTerms String?
  fees          Decimal   @default(0) @db.Decimal(18, 2)
  maturity      DateTime?
  reason        String
  requestedBy   String
  approvedBy    String?
  status        String    @default("REQUESTED")
  loan          Loan      @relation(fields: [loanId], references: [id], onDelete: Cascade)
}

model LendingHoliday {
