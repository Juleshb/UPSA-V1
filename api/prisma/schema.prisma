  exposure    Decimal @db.Decimal(18, 2)
  purpose     String
  tenorMonths Int
  repayment   String?
  eligibility String
  capacity    String
  decision    String
  loan        Loan    @relation(fields: [loanId], references: [id], onDelete: Cascade)
}

model LendingRefinance {
