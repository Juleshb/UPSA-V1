  createdAt             DateTime @default(now())
  member                Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  fee                   MembershipFee @relation(fields: [feeId], references: [id], onDelete: Cascade)

  @@index([memberId])
}

model MembershipCertificate {
