model LendingNotice {
  id        String   @id @default(cuid())
  publicId  String   @unique
  reference String?
  event     String
  channel   String
  subject   String
  body      String
  status    String   @default("QUEUED")
  createdAt DateTime @default(now())
}

model LendingAudit {
  id             String   @id @default(cuid())
  publicId       String   @unique
